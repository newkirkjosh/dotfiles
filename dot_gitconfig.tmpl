{{/* ~/.gitconfig — templated from chezmoi prompts. No secrets; signingkey is a public key. */}}

[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{- if .signingkey }}
    signingkey = {{ .signingkey | quote }}
{{- end }}

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    autocrlf = input
    editor = nvim
    # Global hooks: private-term check for public repos, then the repo's own hooks.
    hooksPath = ~/.config/git/hooks

[color]
    ui = auto

[rerere]
    enabled = true

[diff]
    colorMoved = default

{{- if .signingkey }}

[gpg]
    format = ssh

[gpg "ssh"]
{{- /* The signer's path depends on how 1Password was packaged, not on the
       distro: the upstream rpm and the Arch package install to /opt/1Password
       (on Bazzite /opt resolves to /usr/lib/opt), while a repackaged rpm put
       it in /usr/share/1password with a /usr/libexec link. Use the first that
       exists at apply time; fall back to the upstream path. Inside the
       arch-dev distrobox, only the host's paths (under /run/host) are checked,
       since ~/.gitconfig is shared with the host. */}}
{{- $root := "" }}
{{- if stat "/run/host/usr" }}{{ $root = "/run/host" }}{{ end }}
{{- $opSshSign := "/opt/1Password/op-ssh-sign" }}
{{- range list "/opt/1Password/op-ssh-sign" "/usr/lib/opt/1Password/op-ssh-sign" "/usr/libexec/op-ssh-sign" "/usr/share/1password/op-ssh-sign" | reverse }}
{{-   if stat (print $root .) }}{{ $opSshSign = . }}{{ end }}
{{- end }}
    program = "{{ $opSshSign }}"
    allowedSignersFile = "~/.config/git/allowed_signers"

[commit]
    gpgsign = true

[tag]
    gpgsign = true
{{- end }}

{{ if ne .chezmoi.osRelease.id "bazzite" -}}
{{/* On Bazzite, /usr/bin is read-only (ostree) and gh lives under brew.
     Use SSH remotes (git@github.com:...) so pushes go through the 1Password
     SSH agent. The HTTPS credential helper here would only resolve on Arch. */}}
[credential "https://github.com"]
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper = !/usr/bin/gh auth git-credential
{{- end }}

[alias]
    st = status -sb
    co = checkout
    cob = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    amend = commit --amend --no-edit
    unstage = reset HEAD --
    last = log -1 HEAD
    df = diff
    dfs = diff --staged
    lg = log --oneline --decorate --graph
    lga = log --oneline --decorate --graph --all
    sync = !git fetch --all --prune && git pull --rebase
    wip = !git add -A && git commit -m 'WIP'
