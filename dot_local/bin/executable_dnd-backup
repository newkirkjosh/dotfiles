#!/usr/bin/env bash
# One-way backup of the D&D vault (~/Documents/dnd) to Google Drive, into the
# backup folder Joshua created in Drive.
#
# The vault has a local-only git repo with no remote (players' backstories and
# paid module text never go on GitHub), so this is its only off-machine copy.
# .git is skipped: its pack files churn and would fill changed/.
#
#   <remote>/current            mirror of the vault as of the last run
#   <remote>/changed/YYYY-MM-DD files that run overwrote or deleted
#
# so a bad edit or a deleted note is recoverable for RETENTION days, not just
# until the next sync. Run by dnd-backup.timer; run it by hand any time.
#
# One-time setup: `rclone config` → new remote named "gdrive", type "drive",
# scope 3 (drive.file: rclone sees only the files it created, plus anything
# under its root folder). Then point the remote at the backup folder, keeping
# the folder ID out of this public repo:
#   rclone config update gdrive root_folder_id <folder-id>

set -euo pipefail

# systemd user services start with a minimal PATH that lacks Homebrew.
export PATH="/home/linuxbrew/.linuxbrew/bin:${PATH}"

SRC="${HOME}/Documents/dnd"
# An override must end in ":" or "/" (paths below are appended directly).
REMOTE="${DND_BACKUP_REMOTE:-gdrive:}"
REMOTE_NAME="${REMOTE%%[:,]*}"
RETENTION="${DND_BACKUP_RETENTION:-90d}"

if ! command -v rclone >/dev/null 2>&1; then
    echo "dnd-backup: rclone not installed (brew install rclone)" >&2
    exit 1
fi

if ! rclone listremotes | grep -qx "${REMOTE_NAME}:"; then
    echo "dnd-backup: rclone remote '${REMOTE_NAME}' not configured — run: rclone config" >&2
    exit 1
fi

[ -d "$SRC" ] || { echo "dnd-backup: $SRC missing" >&2; exit 1; }

rclone sync "$SRC" "${REMOTE}current" \
    --backup-dir "${REMOTE}changed/$(date +%F)" \
    --exclude "/.git/**" \
    --fast-list --stats-one-line --stats 0 -v

rclone delete "${REMOTE}changed" --min-age "$RETENTION" --rmdirs 2>/dev/null || true

echo "dnd-backup: synced $SRC → ${REMOTE}current"
