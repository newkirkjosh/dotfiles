#!/usr/bin/env bash
# Cache 1Password secrets in the kernel user keyring, so 1Password prompts once
# per boot instead of on every use. Nothing is written to disk; a reboot or
# `secret clear` drops them.
#
#   secret get <name>       print the secret (no newline), loading it on a miss
#   secret load [name...]   load names (default: every name in the refs file)
#   secret clear [name...]  drop names from the keyring (default: all)
#   secret list             names in the refs file, and whether each is cached
#
# Names map to 1Password references in a local-only refs file (never in this
# repo), one per line, '#' comments allowed:
#   unifi-api  op://<vault>/<item>/<field>
# Location: $SECRET_REFS, default ~/.config/secret/refs.
#
# Keys live in the user keyring (@u) as "secret:<name>" and expire after
# $SECRET_TTL seconds (default 43200, 12h; 0 = never). Any process running as
# this user can read them, the same exposure as an unlocked op session.
#
# Inside a distrobox the container has its own keyring and no op, so the call
# is handed to the host copy through distrobox-host-exec.

set -euo pipefail
# Without this, a die() inside $(...) doesn't stop the caller.
shopt -s inherit_errexit

if [ -e /run/.containerenv ] && [ -z "${SECRET_NO_HOST:-}" ] && command -v distrobox-host-exec >/dev/null; then
  exec distrobox-host-exec "${HOME}/.local/bin/secret" "$@"
fi

REFS="${SECRET_REFS:-${XDG_CONFIG_HOME:-$HOME/.config}/secret/refs}"
TTL="${SECRET_TTL:-43200}"

die() { echo "secret: $*" >&2; exit 1; }

# ref <name>: the op:// reference for name, from the refs file.
ref() {
  [ -f "$REFS" ] || die "no refs file at $REFS"
  local r
  r=$(awk -v n="$1" '$1 == n && $1 !~ /^#/ { print $2; exit }' "$REFS")
  [ -n "$r" ] || die "'$1' is not in $REFS"
  printf '%s' "$r"
}

names() { [ -f "$REFS" ] && awk 'NF >= 2 && $1 !~ /^#/ { print $1 }' "$REFS"; }

key_id() { keyctl search @u user "secret:$1" 2>/dev/null; }

load() {
  local r id
  r=$(ref "$1")
  # Piped, not passed as an argument: argv is visible to every process.
  id=$(op read --no-newline "$r" | keyctl padd user "secret:$1" @u) \
    || die "could not read $r from 1Password"
  [ "$TTL" = 0 ] || keyctl timeout "$id" "$TTL"
  echo "$id"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  get)
    [ $# = 1 ] || die "usage: secret get <name>"
    id=$(key_id "$1") || id=$(load "$1")
    keyctl pipe "$id"
    ;;
  load)
    [ $# -gt 0 ] || set -- $(names)
    [ $# -gt 0 ] || die "no names in $REFS"
    for n in "$@"; do load "$n" >/dev/null && echo "loaded $n"; done
    ;;
  clear)
    [ $# -gt 0 ] || set -- $(names)
    for n in "$@"; do
      if id=$(key_id "$n"); then keyctl unlink "$id" @u >/dev/null && echo "cleared $n"; fi
    done
    ;;
  list)
    for n in $(names); do
      if key_id "$n" >/dev/null; then echo "$n cached"; else echo "$n -"; fi
    done
    ;;
  *)
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
