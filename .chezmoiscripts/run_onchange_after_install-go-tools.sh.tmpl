#!/usr/bin/env bash
# Installs Go CLIs from .chezmoidata/go-tools.yaml into ~/.local/bin.
# - Bazzite: builds inside the arch-dev distrobox, where mise provides Go.
# - Arch: builds on the host.
# Private modules under github.com/newkirkjosh are fetched over SSH, so this
# skips with a warning until the SSH agent is unlocked.

set -euo pipefail

# go install with: static binaries in ~/.local/bin, private modules bypassing the public proxy,
# and git rewriting github.com HTTPS URLs to SSH.
GO_ENV=(
    CGO_ENABLED=0
    GOPRIVATE=github.com/newkirkjosh/*
    GIT_CONFIG_COUNT=1
    GIT_CONFIG_KEY_0=url.git@github.com:.insteadOf
    GIT_CONFIG_VALUE_0=https://github.com/
)

{{ if eq .chezmoi.osRelease.id "bazzite" "fedora" -}}
CONTAINER="{{ .bazzite.distrobox.name }}"
if ! command -v distrobox >/dev/null 2>&1 || ! distrobox list | awk '{print $3}' | grep -qx "$CONTAINER"; then
    echo "⚠ distrobox '$CONTAINER' not found — skipping Go tools"
    exit 0
fi
# $HOME is resolved inside the container: its path can differ from the host's.
run() { distrobox enter "$CONTAINER" -- bash -c 'command -v go >/dev/null && mkdir -p "$HOME/.local/bin" && exec env GOBIN="$HOME/.local/bin" "$@"' _ "$@"; }
{{ else -}}
run() { command -v go >/dev/null && mkdir -p "$HOME/.local/bin" && env GOBIN="$HOME/.local/bin" "$@"; }
{{ end -}}

{{ range .go_tools }}
echo "→ go install {{ . }}"
run "${GO_ENV[@]}" go install {{ . | quote }} || echo "⚠ could not install {{ . }} (no Go, or no SSH access) — skipping"
{{ end }}
