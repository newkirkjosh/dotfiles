#!/usr/bin/env bash
# Clones the personal skill catalogs and symlinks every skill into
# ~/.claude/skills (Claude Code) and ~/.agents/skills (Codex) via each
# catalog's own scripts/install.sh. The core catalog (newkirkjosh/skills) and
# the domain catalogs split out of it are installed the same way.
# Links point into the checkouts, so later skill edits need no re-run; re-run
# a catalog's install.sh by hand after adding, renaming or deleting a skill.
#
# One catalog failing never stops the others. A catalog that can't be cloned
# is skipped with a warning; an install that fails makes the script exit
# non-zero at the end, so chezmoi reports it and runs it again next apply.
# test/install-skills.sh covers both.

set -uo pipefail

CATALOGS="skills dnd-skills unifi-skills"
base="${SKILL_CATALOGS_DIR:-{{ .chezmoi.homeDir }}/Developer}"
failed=""

for name in $CATALOGS; do
    repo="newkirkjosh/$name"
    dest="$base/$name"

    if [ ! -d "$dest/.git" ]; then
        mkdir -p "$base"
        if ! git clone "git@github.com:$repo.git" "$dest" 2>/dev/null; then
            if ! { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1 &&
                gh repo clone "$repo" "$dest"; }; then
                echo "⚠ could not clone $repo (SSH and gh both failed) — skipping it"
                continue
            fi
        fi
    fi

    if ! "$dest/scripts/install.sh"; then
        failed="$failed $name"
    fi
done

if [ -n "$failed" ]; then
    echo "⚠ skill install failed for:$failed"
    echo "  A link collision usually means a checkout predates the catalog split:"
    echo "  update it (git -C $base/skills pull --ff-only), then run chezmoi apply again."
    exit 1
fi
